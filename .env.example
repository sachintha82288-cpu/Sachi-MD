BOT_NAME=Sachi MD
BOT_PREFIX=.
# Where the bot listens: self | inbox | public | groups | all.
# The .mode command (owner only) overrides this and is saved in
# data/settings.json — this value is only the starting point.
BOT_MODE=all
WA_PHONE_NUMBER=94750404115
# The main number can also be typed straight into the terminal on the first
# start (it is then saved to .env). always = ask when a terminal is attached,
# never = never ask, if-unset = ask only when WA_PHONE_NUMBER is missing.
WA_ASK_PHONE=always
# How long the terminal waits for the number before giving up and using the
# configured one (ms). Keeps unattended starts from hanging.
WA_ASK_TIMEOUT_MS=30000
SERVER_PORT=3000

# Dynamic V2Ray / Xray subscription. Can be a URL or one vmess:// / vless:// link.
V2RAY_SUB_URL=
PROXY_ENABLED=true
PROXY_REFRESH_MINUTES=30
PROXY_REQUEST_TIMEOUT_MS=30000
PROXY_HEALTH_TIMEOUT_MS=10000

MAX_VIDEO_MB=60
MAX_AUDIO_MB=25
MAX_DIRECT_MB=40
MAX_MEDIAFIRE_GB=10
MAX_APK_MB=500
MAX_CONCURRENT_DOWNLOADS=2

# Built-in AI — notrack.ai (free, no key needed). Values below are optional overrides.
NOTRACK_MODEL=C
NOTRACK_PERSONA=normal
NOTRACK_TIMEOUT_MS=90000
# How often the live "thinking" message is re-edited while the AI streams (ms)
NOTRACK_STREAM_EDIT_MS=1300
# notrack.ai allows ~1 request per IP at a time; extra .ai calls queue up
# (max wait below) instead of failing. Queue overflow = friendly busy msg.
NOTRACK_MAX_CONCURRENT=1
NOTRACK_QUEUE_MS=45000
# Downloader safety / reliability
MAX_REDIRECTS=5

# Downloader
RAM_DOWNLOADS=true
PROGRESS_UPDATE_MS=1200


# Anti-ban → see the full "Speed / anti-ban balance" block below.

# Limits (single source of truth — keep only this block)
MAX_VIDEO_MB=100
MAX_AUDIO_MB=50
MAX_DIRECT_MB=80
MAX_CONCURRENT_DOWNLOADS=3

# YouTube cookies (optional)
# YTDLP_COOKIES=./data/cookies.txt

# Command-detection reactions (instant emoji on the user's message)
REACTIONS_ENABLED=true
REACTION_MAX_PER_MINUTE=20
REACTION_COOLDOWN_MS=1000

# Media tools (sticker2img / img2sticker)
STICKER_MEDIA_CAP_MB=15
# Optional AI background cutout for .img2sticker — enable with:
#   npm install @imgly/background-removal-node
# Model size when installed: small (~40 MB) | medium (~80 MB). Default: small
BG_REMOVE_MODEL=small

# Status RAM cache (.status / .autoforward) — no restriction is hard-coded,
# every limit below can be raised.
STATUS_TTL_HOURS=72
STATUS_MAX_PER_USER=200
STATUS_MAX_USERS=5000
STATUS_MAX_MEDIA_MB=100
# How many statuses ".status all" sends by default
STATUS_LATEST=10
# Users listed on the ".status" dashboard (reply with a number to download)
STATUS_DASH_USERS=8
# How long ".status <number>" waits for a live push when nothing is cached
STATUS_FRESH_WAIT_MS=6000
# Pull recent statuses during the boot history sync (heavier startup)
SYNC_FULL_HISTORY=false
# Safety cap: most statuses ONE command may send (anti-ban, not a feature
# limit — raise it if you really want 500 messages in a row)
STATUS_SEND_MAX=100
# Keep the status cache across restarts (keys + metadata, never media bytes)
STATUS_PERSIST=true
STATUS_PERSIST_MAX=300
STATUS_PERSIST_DEBOUNCE_MS=2000

# Group tagging (.tagall)
# Who may tag everyone: owner | admin | all   (also: .tagperm in WhatsApp)
TAGALL_PERMISSION=all
# Mentions per message — big groups are split into several messages
TAGALL_CHUNK=100
# Never send more than this many messages for one tagall. A group too big to
# PRINT is tagged silently instead (everyone is still notified).
TAGALL_MAX_MESSAGES=10
# Announcement length cap (WhatsApp rejects over-long texts)
TAGALL_MAX_TEXT=2400

# Crash watchdog — after this many crashes inside the window the process
# exits(1) so the panel restarts the bot instead of limping on half-dead.
# Reports land in data/crash.log (.health shows the last one).
CRASH_RESTART=true
CRASH_LIMIT=3
CRASH_WINDOW_MS=60000

# Ignore commands older than this many seconds (offline-backlog replay guard).
# When the bot reconnects, WhatsApp replays messages received while it was
# down — with this, old commands are never answered. Default: 180
# A command older than this is never answered (WhatsApp replays everything a
# number received while it was offline).
STALE_COMMAND_SEC=180
# Clock-skew allowance when deciding whether a message predates the socket —
# anything stamped before the connection opened is a replay, not a request.
SYNC_GRACE_MS=10000

# Interactive button menus (native-flow). Body text always keeps the classic
# number menu, so clients that don't render buttons still work. Default: on
MENU_BUTTONS=true
# How long to wait for the delivery receipt of an interactive card before
# deciding it did not land (ms). Default: 7000
MENU_ENVELOPE_TIMEOUT_MS=7000
# How long a destructive-command confirmation stays valid (ms). Default: 60000
MENU_CONFIRM_TTL_MS=60000

# Optional: protect the web status endpoint (port from config) with a
# shared secret. Requests then need ?token=… or Authorization: Bearer …
# STATUS_TOKEN=change-me-long-random

# ── Speed / anti-ban balance (v1.1.4) ────────────────────────────────
# The typing indicator now starts the moment YOUR message arrives, so this
# budget overlaps the command's own work: a slow command (AI, download,
# sticker) adds ~0 ms, and a short reply is capped instead of padded.
#
# Preset: conservative | moderate | aggressive | turbo
#   turbo = 30/min · 400/hr · 2500/day — only for an aged, trusted number.
ANTIBAN_PRESET=moderate
ANTIBAN_ENABLED=true
# Typing indicator simulation (off = faster, much less human)
ANTIBAN_TYPING=true
# New-account warm-up caps (turn off only for aged accounts)
ANTIBAN_WARMUP=true
#
# Wall-time budgets (ms)
ANTIBAN_FAST_MAX_MS=800            # short replies: acks, errors, .ping
ANTIBAN_REPLY_MAX_MS=1400          # a normal reply in a chat the bot knows
ANTIBAN_NEW_CHAT_TYPING_MS=2400    # the FIRST message to a brand-new chat
ANTIBAN_TYPING_MAX_MS=1600         # longest "typing…" for one message
ANTIBAN_TYPING_MIN_MS=650          # …and the shortest (a flash nobody sees)
ANTIBAN_TYPING_TTL_MS=120000       # forget a stuck indicator after this long
ANTIBAN_TYPING_WPM=42              # typing speed used to size the indicator
ANTIBAN_MAX_BLOCK_MS=15000         # never sit in the rate limiter longer than this
#
# Fairness — one loud group cannot starve everybody else
ANTIBAN_PER_CHAT_MIN_MS=450        # minimum gap between two sends in one chat
ANTIBAN_PER_CHAT_PER_MINUTE=6      # …and how many that chat may take per minute
#
# Menu cards are real outbound messages, so they get their own budget.
# When it runs out the bot falls back to the image menu instead of hammering.
ANTIBAN_PROBE_MAX_PER_WINDOW=12
ANTIBAN_PROBE_WINDOW_MS=10000
ANTIBAN_PROBE_BLOCK_MS=600
#
# Risk scoring: what counts as trouble, and how fast it is forgiven
ANTIBAN_DECAY_MS_PER_POINT=15000   # 1 risk point forgiven per 15 s of quiet
ANTIBAN_BAN_MEMORY_MS=1800000      # a ban signal escalates the next one for 30 min
#
# State: data/antiban-state.json keeps the risk score, the rate counters and
# the warm-up day count across restarts, so a crash loop cannot "forget" that
# the number was in trouble.
ANTIBAN_STATE_SAVE_MS=2000
# What the first message after the daily warm-up cap pays (and the next ones)
ANTIBAN_WARMUP_PENALTY_MS=6000
ANTIBAN_WARMUP_PENALTY_REPEAT_MS=1500

# ── Everything else the bot reads (defaults in brackets) ──
# Where the session files live (default: sessions)
SESSION_NAME=sessions
# Only the owner may use the bot at all (default: false)
OWNER_ONLY=false
# Answer in groups (default: true) — set false for a private bot
ALLOW_GROUPS=true
# Web status server port (default: 3000)
PORT=3000
# Shared secret for the web status endpoint (empty = open)
STATUS_TOKEN=

# ── Multi-session & the pair website (v1.2.0) ────────────────────────────
# Who may open the pair page: public | token | off   (default: public)
PAIR_MODE=public
# Passcode visitors must add (?token=…) when PAIR_MODE=token
PAIR_TOKEN=
# Owner console (/admin) and /api/admin/*. Empty = the console stays LOCKED.
PAIR_ADMIN_TOKEN=
# The address people should open. Leave it EMPTY and the bot works it out at
# boot — panel env vars, then a public-IP lookup, then the port it bound to —
# and prints it in the terminal with a QR code. On Pterodactyl, if the panel
# gives you a different IP:port than the one printed (check the ALLOCATIONS
# tab), put it here, e.g. PAIR_PUBLIC_URL=http://136.67.120.86:3000/
PAIR_PUBLIC_URL=
# How many paired sessions this bot carries at once
PAIR_MAX_SESSIONS=8
# A WhatsApp pairing code lives about a minute (floor: 10 s)
# Pin every pairing code to one number, for testing on a private panel.
# Leave EMPTY in production: a code that never changes can be memorised by
# anyone who can open the pair page.
PAIR_FIXED_CODE=

PAIR_CODE_TTL_MS=60000
# How long an unfinished attempt keeps its socket before it is torn down
PAIR_PENDING_TTL_MS=900000
# Two requests for the same number this close together are refused
PAIR_COOLDOWN_MS=30000
# Rate-limit window and budgets: per number, and per visitor IP
PAIR_RATE_WINDOW_MS=600000
PAIR_MAX_PER_PHONE=3
PAIR_MAX_PER_IP=6
# Coarse HTTP limiter — requests per minute per IP (pages / json api / pair api)
PAIR_HTTP_PAGE_PER_MIN=60
PAIR_HTTP_API_PER_MIN=90
PAIR_HTTP_PER_MIN=12
# Print a scannable QR for the pair page in the terminal (false to skip)
PAIR_QR=true
# Only set this if a proxy in front of the bot sends X-Forwarded-For
TRUST_PROXY=false
# How long a "reply with a number" selection stays valid (default: 120000)
SELECTION_TTL_MS=120000
# How long the menu waits for a delivery receipt before it falls back (default: 9000)
MENU_FALLBACK_MS=9000
# Anti-ban overrides (leave empty to use the preset)
# ANTIBAN_MAX_PER_MINUTE=12
# ANTIBAN_MAX_PER_HOUR=150
# ANTIBAN_MAX_PER_DAY=1000
# ANTIBAN_MIN_DELAY=900
# ANTIBAN_MAX_DELAY=4200
# ANTIBAN_NEW_CHAT_DELAY=2800
# AI service
# NOTRACK_API_URL=https://notrack.ai/api/dispatch
# Give up on an AI answer after this long without a chunk (default: 45000)
NOTRACK_IDLE_MS=45000
# Media
# FFmpeg timeout for the sticker pipeline (default: 90000)
STICKER_FFMPEG_TIMEOUT_MS=90000
# YouTube cookies (a file path) for age-restricted videos
# YTDLP_COOKIES=./data/cookies.txt
# YOUTUBE_COOKIES=./data/cookies.txt

# ── HTTPS (the pair website) ────────────────────────────────────────────────
# The panel gives you ONE port, so the bot serves HTTPS on it itself: a plain
# http:// request on the same port is answered with a 301 to https://.
HTTPS_ENABLED=true
# A REAL certificate (Let's Encrypt through the panel, Cloudflare origin cert, a
# reverse proxy…). Leave empty and the bot generates a self-signed certificate on
# first boot, stores it in data/tls/ and reuses it — the browser warning is
# accepted once and then stays accepted. Paths may be absolute or project-relative.
SSL_CERT_PATH=
SSL_KEY_PATH=
# How long browsers should remember to use HTTPS (seconds; 0 disables HSTS).
HTTPS_HSTS_MAX_AGE=2592000
# WhatsApp drops an unlinked pairing socket after ~a minute. The bot re-opens it
# and asks for a NEW code (the old one dies with the socket); this is how many
# times one attempt may do that before it is given up.
PAIR_MAX_CODE_ROTATIONS=20
# Never issue two codes closer together than this (ms) — two rotation sources
# firing at once would silently invalidate the code already on screen.
PAIR_ROTATE_GAP_MS=5000

# ── downloaders ─────────────────────────────────────────────────────────────
# Highest video stream yt-dlp is allowed to pick when the user does not ask.
# WhatsApp re-compresses everything to a few MB anyway; 4K just burns disk and
# minutes of ffmpeg.
YTDLP_MAX_HEIGHT=1080
